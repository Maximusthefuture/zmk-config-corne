#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

&mt {
    quick-tap-ms = <100>;
    require-prior-idle-ms = <100>;
    flavor = "tap-preferred";
    tapping-term-ms = <180>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&kp ESC>;
        };

        screenshot {
            bindings = <&mt PRINTSCREEN LG(LS(NUMBER_4))>;
            key-positions = <30 31 32 33>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <29 28 27>;
        };

        toggleshift {
            bindings = <&kt LEFT_SHIFT>;
            key-positions = <18 19 20>;
        };

        bspace_right {
            bindings = <&kp BACKSPACE>;
            key-positions = <30 31 32>;
        };

        copy {
            bindings = <&kp C_AC_COPY>;
            key-positions = <15 16>;
        };

        paste {
            bindings = <&kp C_AC_PASTE>;
            key-positions = <17 16>;
        };

        layout {
            bindings = <&kp LS(LEFT_ALT)>;
            key-positions = <13 14 15 28>;
        };

        Project_window {
            bindings = <&kp LA(NUMBER_1)>;
            key-positions = <14 15>;
        };

        Git_window {
            bindings = <&kp LA(N9)>;
            key-positions = <26 27>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // The outer positions on the top two rows have no Totem equivalent.
        base_layer {
            label = "BASE";
            bindings = <
                &none  &kp Q  &kp W  &kp E  &kp R  &kp T    &kp Y  &kp U  &kp I  &kp O  &kp P  &none
                &none  &mt LCTRL A  &mt LSHIFT S  &mt LEFT_ALT D  &kp F  &kp G    &kp H  &kp J  &mt RIGHT_ALT K  &mt RIGHT_SHIFT L  &mt RCTRL SEMI  &none
                &kp ESC  &kp Z  &kp X  &kp C  &kp V  &kp B    &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp APOS
                    &kp LGUI  &lt NAV TAB  &kp SPACE    &kp RET  &mo SYM  &kp BSPC
            >;
        };

        nav_layer {
            label = "NAVI";
            bindings = <
                &none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5    &kp NUMBER_6  &kp N7  &kp NUMBER_8  &kp NUMBER_9  &kp N0  &none
                &none  &kp LA(ENTER)  &kp LS(F6)  &kp LS(LC(L))  &mt LG(A) LC(A)  &kp PAGE_UP    &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &kp HOME  &none
                &kp GRAVE  &kp LC(Z)  &none  &none  &trans  &kp PAGE_DOWN    &kp F6  &kp F7  &kp F8  &kp F9  &kp END  &kp DELETE
                    &trans  &trans  &trans    &mo ADJ  &none  &trans
            >;
        };

        sim_layer {
            label = "SYM";
            bindings = <
                &none  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &none
                &none  &kp RA(A)  &kp LS(LSHIFT)  &kp RA(S)  &mt LG(LS(LEFT)) LG(LEFT)  &mt LG(LS(RIGHT)) LG(RIGHT)    &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH  &none
                &kt LEFT_ALT  &none  &kp LC(LEFT_CONTROL)  &kp K_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP    &kp UNDER  &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE  &kp TILDE
                    &trans  &none  &mo ADJ    &trans  &none  &trans
            >;
        };

        adjust_layer {
            label = "ADJ";
            bindings = <
                &none  &sys_reset  &none  &out OUT_TOG  &bt BT_CLR  &bt BT_SEL 0    &trans  &kp F1  &kp F2  &kp F3  &kp F4  &none
                &none  &bootloader  &none  &none  &trans  &bt BT_SEL 1    &trans  &kp F5  &kp F6  &kp F7  &kp F8  &none
                &trans  &trans  &none  &none  &bt BT_SEL 3  &bt BT_SEL 2    &trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans
                    &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
